# Copy to .env and fill in your values:
#   copy .env.example .env

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Use a long random secret in production (32+ chars). Required when NODE_ENV=production.
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
APP_TZ=Asia/Aden

# Comma-separated admin/web origins. Mobile apps ignore CORS.
# Example: https://admin.hadjzi.com
CORS_ORIGINS=

# DB pool (keep low on Supabase transaction pooler)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
DB_SLOW_QUERY_MS=1000

# Optional
TYPEORM_LOGGING=false
BOOKING_LOCK_MINUTES=15
COMMISSION_PERCENTAGE=10
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Cloudinary (images uploaded via POST /api/uploads/image — only URLs stored in DB)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hadjzi

# OTP
OTP_EXPIRES_MINUTES=5
OTP_COOLDOWN_SECONDS=45
# MUST be false in production (hides code from API responses)
OTP_DEV_ECHO=true

# Payments
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# --- SMS (Twilio) — required for real SMS delivery ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# --- WhatsApp: pick ONE of Meta Cloud API or Twilio WhatsApp ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
TWILIO_WHATSAPP_FROM=
