    "db:seed:deposit": "node scripts/apply-sql.mjs sql/007_deposit_30.sql",
    "db:admin": "node scripts/apply-sql.mjs sql/011_admin_platform.sql",
    "db:seed:avail": "node scripts/refill-availabilities.js",
    "db:seed:test": "node scripts/apply-sql.mjs sql/003_seed.sql && node scripts/apply-sql.mjs sql/005_category_taxonomy.sql && node scripts/apply-sql.mjs sql/004_test_data.sql && node scripts/apply-sql.mjs sql/006_extra_test_data.sql",
